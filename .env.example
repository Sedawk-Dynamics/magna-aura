# Copy this file to .env.local and fill in the values.
# The contact form sends enquiries through Resend (https://resend.com).

# API key from the Resend dashboard
RESEND_API_KEY=

# Verified sender address on your Resend domain
ENQUIRY_FROM_EMAIL=Al-Noor Arabia <enquiries@your-domain.com>

# Inbox that receives enquiries (optional; defaults to info@alnoorarabia-consultants.com)
ENQUIRY_TO_EMAIL=info@alnoorarabia-consultants.com
